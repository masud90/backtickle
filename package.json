{
  "name": "backtickle",
  "version": "0.2.1",
  "private": true,
  "description": "A free, open-source Markdown editor and reader for macOS, Windows and Linux",
  "license": "MIT",
  "author": "Masud Rahman",
  "repository": "github:masud90/backtickle",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "app:dev": "tauri dev",
    "tauri": "tauri",
    "build": "vite build",
    "build:app": "bash scripts/build-app.sh",
    "build:app:universal": "bash scripts/build-app.sh --universal",
    "build:app:windows": "tauri build --bundles nsis,msi",
    "build:app:linux": "tauri build --bundles deb,appimage",
    "dmg": "bash scripts/make-dmg.sh",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:fidelity": "vitest run -c tests/fidelity/vitest.config.ts",
    "test:pandoc": "vitest run -c tests/pandoc/vitest.config.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.7.2",
    "@retorquere/bibtex-parser": "11.0.0",
    "@tauri-apps/api": "2.12.1",
    "@viz-js/viz": "3.30.0",
    "dompurify": "3.4.16",
    "hast-util-from-dom": "5.0.1",
    "hast-util-to-mdast": "10.1.2",
    "js-yaml": "5.4.2",
    "katex": "0.19.0",
    "markdown-it": "15.0.3",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mdast-util-mdx": "3.0.0",
    "mdast-util-to-markdown": "2.1.2",
    "mermaid": "12.1.0",
    "micromark": "4.0.3",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-extension-mdxjs": "3.0.0",
    "morphdom": "2.7.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lexend-deca": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@material-symbols/svg-400": "^0.47.6",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/svelte": "5.4.2",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.1",
    "commonmark-spec": "0.31.2",
    "happy-dom": "20.14.5",
    "jsdom": "29.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "mermaid": {
      "katex": "0.18.9"
    },
    "micromark-extension-math": {
      "katex": "0.18.9"
    }
  }
}
