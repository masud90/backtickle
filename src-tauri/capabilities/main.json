{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "What the main Writedown window and any other document window (doc-<n>, a tab moved to a new window) may do. Keep this list as short as possible. There is no file system, dialog or opener permission: files are chosen, read, saved and revealed through our own commands, which only serve paths Rust granted (see src/grants.rs).",
  "windows": ["main", "doc-*"],
  "permissions": [
    "core:app:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:default",
    "core:window:allow-start-dragging",
    "allow-ping",
    "allow-app-version",
    "allow-launch-options",
    "allow-pick-file",
    "allow-read-text-file",
    "allow-perf-mark",
    "allow-bench-report",
    "allow-bench-search-report",
    "allow-open-dialog",
    "allow-save-dialog",
    "allow-read-document",
    "allow-save-document",
    "allow-document-context",
    "allow-reveal-in-finder",
    "allow-open-external",
    "allow-open-linked-document",
    "allow-reveal-linked-file",
    "allow-resolve-image",
    "allow-recent-documents",
    "allow-open-recent",
    "allow-remove-recent",
    "allow-clear-recents",
    "allow-get-settings",
    "allow-get-snippets",
    "allow-set-snippets",
    "allow-update-settings",
    "allow-get-doc-state",
    "allow-set-doc-state",
    "allow-take-pending-open-files",
    "allow-confirm-unsaved",
    "allow-ask",
    "allow-update-menu-state",
    "allow-set-window-title",
    "allow-open-preferences",
    "allow-ack-close",
    "allow-finish-close",
    "allow-cancel-close",
    "allow-menu-ready",
    "allow-read-linked-text",
    "allow-vault-index",
    "allow-quarto-project",
    "allow-folder-dialog",
    "allow-list-folder",
    "allow-file-index",
    "allow-create-file",
    "allow-create-folder",
    "allow-rename-path",
    "allow-move-path",
    "allow-duplicate-path",
    "allow-trash-path",
    "allow-write-clipboard",
    "allow-read-clipboard-text",
    "allow-print-page",
    "allow-write-export",
    "allow-pandoc-info",
    "allow-export-docx",
    "allow-pandoc-preview",
    "allow-cancel-pandoc-preview",
    "allow-export-pdf",
    "allow-render-with-quarto",
    "allow-read-image-bytes",
    "allow-save-pasted-image",
    "allow-import-dropped-image",
    "allow-get-session",
    "allow-set-session",
    "allow-recovery-write",
    "allow-recovery-remove",
    "allow-recovery-list",
    "allow-move-tab",
    "allow-take-transfer",
    "allow-set-window-documents",
    "allow-set-document-edited",
    "allow-focus-open-document",
    "allow-restore-windows",
    "allow-watch",
    "allow-search-folder",
    "allow-cancel-search"
  ]
}
