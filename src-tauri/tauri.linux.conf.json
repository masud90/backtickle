{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Backtickle",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ]
  },
  "bundle": {
    "targets": ["deb", "appimage"],
    "shortDescription": "A Markdown reader and writer for Linux",
    "longDescription": "Backtickle reads and writes Markdown in six flavors, with a live preview, on Linux.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["xdg-utils"],
        "desktopTemplate": "backtickle.desktop",
        "section": "editors"
      }
    }
  }
}
