    <div class="code-card-header"><span class="code-card-lang">R</span><span class="code-card-actions"><button type="button" class="code-copy"><span class="code-copy-icon"><svg viewBox="0 -960 960 960" width="13" height="13" fill="currentColor" aria-hidden="true" focusable="false">...</svg></span><span class="code-copy-label">Copy</span></button></span></div>
    <pre tabindex="0"><code class="language-r"><span class="tok-variableName">data</span> <span class="tok-operator">&lt;-</span> <span class="tok-variableName">read.csv</span>(<span class="tok-string">"file.csv"</span>)
