    <pre tabindex="0"><code class="language-sql"><span class="tok-keyword">SELECT</span> name<span class="tok-punctuation">,</span> email <span class="tok-keyword">FROM</span> users <span class="tok-keyword">WHERE</span> active <span class="tok-operator">=</span> <span class="tok-bool">true</span>;
